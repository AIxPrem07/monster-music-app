# Neon Database connection string
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cloudflare R2 Credentials
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="monster-audio"
R2_PUBLIC_DOMAIN="https://pub-monster.r2.dev"

# Auth Secret
NEXTAUTH_SECRET="monster_secret_key_32_bytes_super_secure_random"
